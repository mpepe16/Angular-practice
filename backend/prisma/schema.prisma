generator client {
  provider = "prisma-client-js"
  //output   = "./node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Caveman {
  id         String     @id @unique @default(uuid()) @db.Uuid
  name       String
  location   String
  age        Int
  skill_tree SkillTree?
  inventory  Inventory?
  user       User       @relation(fields: [userId], references: [id])
  userId     String     @db.Uuid

  @@unique([userId, name])
}

model Inventory {
  id         String  @id @unique @default(uuid()) @db.Uuid
  durability Int     @default(100)
  caveman_id String  @unique @db.Uuid
  caveman    Caveman @relation(fields: [caveman_id], references: [id], onDelete: Cascade)
  items      Item[]
}

model Item {
  id           String    @id @unique @default(uuid()) @db.Uuid
  name         String
  description  String
  value        Int
  durability   Int
  inventory_id String    @db.Uuid
  inventory    Inventory @relation(fields: [inventory_id], references: [id], onDelete: Cascade)
}

model SkillTree {
  id         String  @id @unique @default(uuid()) @db.Uuid
  skills     Skill[]
  cavemen    Caveman @relation(fields: [caveman_id], references: [id], onDelete: Cascade)
  caveman_id String  @unique @db.Uuid
}

model Skill {
  id            String    @id @unique @default(uuid()) @db.Uuid
  name          String
  description   String
  level         Int
  dependencies  String[]
  skill_tree_id String    @db.Uuid
  skill_tree    SkillTree @relation(fields: [skill_tree_id], references: [id], onDelete: Cascade)
}

model User {
  id       String    @id @unique @default(uuid()) @db.Uuid
  email    String    @unique
  password String
  name     String     @default("")
  age      Int       @default(0)
  caveman  Caveman[]
}
